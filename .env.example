# Local standalone TrueForge server (npx @truefoundry/trueforge@latest)
TRUEFORGE_BASE_URL=http://localhost:8790

# Only needed when the server runs with OIDC login enabled.
# TRUEFORGE_TOKEN=

# Model to use for inline agent specs. Must be configured under Settings -> Models.
TRUEFORGE_MODEL=openai/gpt-5-5

# --- discord-mcp (SaseQ/discord-mcp) ---
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Optional default server id; makes guildId optional on every Discord tool.
DISCORD_GUILD_ID=
DISCORD_MCP_URL=http://localhost:8085/mcp

# --- apple-appstore-reviewer skill ---
# Commit SHA in github/awesome-copilot to pin the skill to.
APPSTORE_SKILL_REF=c0314d9bcb473fac0cc219e062735e3a3cb67cd3

# --- reddit-mcp (jordanburke/reddit-mcp-server) ---
# All optional. Empty = anonymous read-only (~10 req/min).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Needed only for the write tools (create_post, reply_to_post, ...).
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_MCP_URL=http://localhost:3000/mcp

# --- hn-mcp (erithwik/mcp-hn, bridged to HTTP by supergateway) ---
HN_MCP_URL=http://localhost:8086/mcp

# --- linkedin-mcp (stickerdaniel/linkedin-mcp-server) ---
# No key: it drives a logged-in browser session stored in ~/.linkedin-mcp.
# Run the interactive login once:
#   docker run -it --rm -v ~/.linkedin-mcp:/home/pwuser/.linkedin-mcp \
#     stickerdaniel/linkedin-mcp-server:latest --login
LINKEDIN_MCP_URL=http://localhost:8087/mcp

# --- X / Twitter MCP (https://api.x.com/mcp) ---
# App-only bearer token from https://developer.x.com -> your app -> Keys and tokens.
# Read-only. Leave empty to skip registering the X connector entirely.
X_BEARER_TOKEN=

# --- telegram-mcp (chigwell/telegram-mcp) ---
# API id/hash from https://my.telegram.org/apps. The session string comes from
# the repo's generator:  uv run session_string_generator.py --qr
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_MCP_URL=http://localhost:8765/mcp

# --- signal-mcp (rymurr/signal-mcp) ---
# Registered phone number in +E.164 form; register once with signal-cli first.
SIGNAL_USER_ID=
SIGNAL_MCP_URL=http://localhost:8089/mcp

# --- whatsapp-mcp (lharries/whatsapp-mcp) ---
# No key: the Go bridge prints a QR code to link a phone on first run.
WHATSAPP_MCP_URL=http://localhost:8090/mcp
# Set to 1 once the WhatsApp bridge has been linked to a phone.
WHATSAPP_MCP_ENABLED=
