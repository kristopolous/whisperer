# Local standalone TrueForge server (npx @truefoundry/trueforge@latest)
TRUEFORGE_BASE_URL=http://localhost:8790

# Only needed when the server runs with OIDC login enabled.
# TRUEFORGE_TOKEN=

# Model to use for inline agent specs. Must be configured under Settings -> Models.
TRUEFORGE_MODEL=openai/gpt-5-5

# --- discord-mcp (SaseQ/discord-mcp) ---
# One-time setup, all in https://discord.com/developers/applications :
#   1. New Application -> name it -> Bot (left sidebar).
#   2. Reset Token -> copy it into DISCORD_TOKEN below. It's shown once.
#   3. Privileged Gateway Intents -> turn ON "Server Members Intent". This is
#      the only privileged intent the server actually asks for (verified in
#      its source, DiscordMcpConfig.java: GUILD_MEMBERS, GUILD_VOICE_STATES,
#      SCHEDULED_EVENTS on top of JDA's default set) — Message Content is not
#      requested, so it does not need to be enabled.
#   4. OAuth2 -> URL Generator -> scope "bot" -> permissions: pick
#      "Administrator" for the simple path (this bot's tool set spans
#      channels, roles, moderation, webhooks, voice, events and emojis, and
#      hand-picking a permission set that covers all of them is easy to get
#      subtly wrong); pick individually if you'd rather not grant admin on a
#      real server. Open the generated URL, pick the server, Authorize.
#   5. Discord app -> Settings -> Advanced -> enable Developer Mode, then
#      right-click the server icon -> Copy Server ID -> DISCORD_GUILD_ID below.
DISCORD_TOKEN=
# Optional, but every tool needs guildId without it — set it (step 5 above).
DISCORD_GUILD_ID=
DISCORD_MCP_URL=http://localhost:8085/mcp

# --- apple-appstore-reviewer skill ---
# Commit SHA in github/awesome-copilot to pin the skill to.
APPSTORE_SKILL_REF=c0314d9bcb473fac0cc219e062735e3a3cb67cd3

# --- reddit-mcp (jordanburke/reddit-mcp-server) ---
# All optional. Empty = anonymous read-only (~10 req/min).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Needed only for the write tools (create_post, reply_to_post, ...).
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_MCP_URL=http://localhost:3000/mcp

# --- hn-mcp (erithwik/mcp-hn, bridged to HTTP by supergateway) ---
HN_MCP_URL=http://localhost:8086/mcp

# --- linkedin-mcp (stickerdaniel/linkedin-mcp-server) ---
# No key: it drives a logged-in browser session stored in ~/.linkedin-mcp.
# Run the interactive login once:
#   docker run -it --rm -v ~/.linkedin-mcp:/home/pwuser/.linkedin-mcp \
#     stickerdaniel/linkedin-mcp-server:latest --login
LINKEDIN_MCP_URL=http://localhost:8087/mcp

# --- X / Twitter MCP (https://api.x.com/mcp) ---
# App-only bearer token from https://developer.x.com -> your app -> Keys and tokens.
# Read-only. Leave empty to skip registering the X connector entirely.
X_BEARER_TOKEN=

# --- telegram-mcp (chigwell/telegram-mcp) ---
# API id/hash from https://my.telegram.org/apps. The session string comes from
# the repo's generator:  uv run session_string_generator.py --qr
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_MCP_URL=http://localhost:8765/mcp

# --- signal-mcp (rymurr/signal-mcp) ---
# Registered phone number in +E.164 form; register once with signal-cli first.
SIGNAL_USER_ID=
SIGNAL_MCP_URL=http://localhost:8089/mcp

# --- whatsapp-mcp (lharries/whatsapp-mcp) ---
# No key: the Go bridge prints a QR code to link a phone on first run.
WHATSAPP_MCP_URL=http://localhost:8090/mcp
# Set to 1 once the WhatsApp bridge has been linked to a phone.
WHATSAPP_MCP_ENABLED=

# --- youtube-mcp (amitpuri/search-youtube) ---
# YouTube Data API v3 key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_MCP_URL=http://localhost:8091/mcp

# --- instagram-mcp (jlbadano/ig-mcp) ---
# Needs an Instagram Business account connected to a Facebook Page.
# https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_MCP_URL=http://localhost:8092/mcp

# --- tiktok-mcp (seym0n/tiktok-mcp) ---
# TikNeuron API key — proxies TikTok search/scraping.
TIKNEURON_MCP_API_KEY=
TIKTOK_MCP_URL=http://localhost:8093/mcp

# --- brave-mcp (brave/brave-search-mcp-server) ---
# https://brave.com/search/api/
BRAVE_API_KEY=
BRAVE_MCP_URL=http://localhost:8094/mcp
